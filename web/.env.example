DATABASE_URL=postgresql://dukaan:dukaan@localhost:5433/dukaan?sslmode=disable
# The MCP server's port — NOT `PORT`, which Next uses for its own.
MCP_PORT=8787
# Set this in a deployment to override host/port entirely.
# MCP_PUBLIC_URL=https://your-host/mcp

# Optional. Unset -> proposeMapping returns null and the UI falls back to
# the exact-header path automatically.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OPTIONAL, and must be set HERE (or in web/.env.local) as well as in the
# repo-root .env to take effect on the onboarding form's write-path check:
# Next reads web/.env.local only, never the root .env. Integer PAISE.
# PLATFORM_SPEND_CEILING_PAISE=
