{
  "name": "dukaan-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/mcp/http.ts",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:nuke": "docker compose down -v",
    "db:reset": "docker compose down -v && docker compose up -d --wait && bun run db:migrate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:psql": "docker compose exec -it postgres psql -U dukaan -d dukaan",
    "dev": "bun --watch src/mcp/http.ts",
    "mcp:dev": "bun --watch src/mcp/http.ts",
    "spike:client": "bun run scripts/spike-client.ts",
    "verify:mcp": "bun run scripts/verify-mcp.ts",
    "smoke:rzp": "bun run scripts/smoke-razorpay.ts",
    "seed:merchant": "bun run scripts/seed-merchant.ts",
    "seed:demo": "bun run scripts/seed-demo.ts",
    "eval": "bun run src/eval/run.ts",
    "eval:generate": "bun run src/eval/generate.ts",
    "audit": "bun run scripts/audit-print.ts",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\""
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/hono": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "csv-parse": "7.0.2",
    "hono": "4.13.3",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "1.4.0",
    "@types/pg": "8.23.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
