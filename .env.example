DATABASE_URL=postgresql://dukaan:dukaan@localhost:5433/dukaan?sslmode=disable
PORT=8787
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Only needed to run `bun run eval:generate:llm` (src/eval/llm-generate.ts) —
# the one deliberate, human-run call to an LLM for DUK-18's independent-
# author eval half. Never read by `bun run eval:generate`, `bun run eval`,
# `bun run eval:report`, or `bun test` — those stay offline with no key.
OPENROUTER_API_KEY=
# Fallback only. The eval corpus was authored by "stealth/ox-alpha", which has
# since been withdrawn (404) — see src/eval/llm-generate.ts.
# and may be renamed or withdrawn without notice. Override here rather than
# in code if it stops working.
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OPTIONAL platform ceiling on the spend cap a merchant may set for ITSELF,
# in integer PAISE (250000 = Rs 2,500.00). Unset means no ceiling, and every
# number `bun run eval` prints is identical either way — leaving it unset is
# what keeps a fresh clone reproducible.
# PLATFORM_SPEND_CEILING_PAISE=
